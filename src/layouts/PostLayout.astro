---
import BaseLayout from "./BaseLayout.astro";
import Disclaimer from "../components/Disclaimer.astro";
import Newsletter from "../components/Newsletter.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const formatted = post.data.pubDate.toLocaleDateString("en-CA", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={post.data.title} description={post.data.description} type="article">
  <article class="wrap article-wrap">
    <header class="post-hero">
      <p class="kicker">{post.data.heroKicker ?? post.data.category}</p>
      <h1>{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <p class="meta">{formatted} · {post.data.tags.join(" · ")}</p>
    </header>
    <div class="prose">
      <slot />
    </div>
    <div style="margin-top: 2rem;">
      <Disclaimer />
    </div>
    <div style="margin-top: 1rem;">
      <Newsletter />
    </div>
  </article>
</BaseLayout>
